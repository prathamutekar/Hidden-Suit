{
  "rules": {
    "roomIndex": {
      ".read": "auth != null",
      ".indexOn": ".value",
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('rooms/' + $code + '/meta/hostUid').val() == auth.uid) || (data.exists() && !newData.exists() && (data.val() < now - 86400000 || root.child('rooms/' + $code + '/meta/hostUid').val() == auth.uid)))",
        ".validate": "newData.isNumber()"
      }
    },
    "rooms": {
      "$code": {
        ".write": "auth != null && !newData.exists() && (data.child('meta/hostUid').val() == auth.uid || data.child('meta/created').val() < now - 86400000)",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (data.exists() ? data.child('hostUid').val() == auth.uid : newData.child('hostUid').val() == auth.uid)",
          ".validate": "$code.matches(/^[A-Z]{4}$/) && newData.hasChildren(['hostUid', 'status', 'created'])"
        },
        "members": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (($uid == auth.uid && (data.exists() || root.child('rooms/' + $code + '/meta/status').val() == 'lobby')) || (!newData.exists() && root.child('rooms/' + $code + '/meta/hostUid').val() == auth.uid))",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "private": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() == auth.uid",
            ".validate": "newData.isString()"
          }
        },
        "inbox": {
          ".read": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() == auth.uid",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() == auth.uid",
          "$id": {
            ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/members/' + auth.uid).exists() && root.child('rooms/' + $code + '/meta/status').val() == 'playing'",
            ".validate": "newData.hasChildren(['uid', 'action']) && newData.child('uid').val() == auth.uid && newData.child('action').isString() && newData.child('action').val().length < 2000"
          }
        },
        "hostData": {
          ".read": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() == auth.uid",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() == auth.uid",
          ".validate": "newData.isString()"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
